// FIRRTL grammar for tree-sitter (native DSL).
// Translated from grammar.js.

macro sep1(sep: rule_t, rule: rule_t) rule_t {
    seq(rule, repeat(seq(sep, rule)))
}

grammar {
    language: "firrtl",
    externals: [_newline, _indent, _dedent],
    extras: [comment, regexp(r"\s")],
    inline: [keyword_identifier],
    supertypes: [expression, statement],
    word: identifier,
}

rule source_file { repeat(circuit) }

rule circuit {
    seq(
        "circuit", identifier, ":", optional(info),
        optional(seq(_indent, repeat(module), _dedent)),
    )
}

rule module {
    choice(
        seq(
            "module", identifier, ":", optional(info),
            optional(seq(
                _indent,
                repeat(port),
                repeat(statement),
                _dedent,
            )),
        ),
        seq(
            "extmodule", identifier, ":", optional(info),
            optional(seq(
                _indent,
                repeat(port),
                optional(defname),
                repeat(parameter),
                _dedent,
            )),
        ),
    )
}

rule port {
    seq(dir, identifier, ":", optional(qualifier), type, optional(info), _newline)
}

rule dir { choice("input", "output") }

rule qualifier { choice("const") }

rule type {
    choice(
        seq(
            choice("UInt", "SInt", "Analog"),
            optional(seq("<", number, ">")),
        ),
        seq(
            "Fixed",
            optional(seq("<", number, ">")),
            optional(seq("<", "<", number, ">", ">")),
        ),
        "Clock",
        "AsyncReset",
        "Reset",
        seq("{", optional(sep1(",", r#field)), "}"),
        seq(type, "[", number, "]"),
    )
}

rule r#field { seq(optional("flip"), field_id, ":", type) }

rule defname { seq("defname", "=", identifier, _newline) }

rule parameter {
    seq(
        "parameter", identifier,
        "=",
        choice(number, string, double, raw_string),
        _newline,
    )
}

rule _reset { seq("reset", "=>", "(", expression, ",", expression, ")") }

rule reset { choice(_reset, seq("(", _reset, ")")) }

rule reset_block {
    choice(
        seq(_indent, reset, optional(info), _newline, _dedent),
        seq("(", reset, ")"),
    )
}

rule statement {
    choice(
        wire, cmem, smem, register, memory, rdwr, inst, node,
        connection, partial_connection, is_invalid, when, stop, printf,
        verif, skip, attach,
    )
}

rule wire { seq("wire", identifier, ":", type, optional(info)) }

rule cmem { seq("cmem", identifier, ":", type, optional(info)) }

rule smem { seq("smem", identifier, ":", type, optional(info)) }

rule register {
    seq(
        "reg", identifier, ":", type, ",", expression,
        optional(seq("with", ":", reset_block)),
        optional(info),
    )
}

rule memory {
    seq(
        "mem", identifier, ":", optional(info),
        _indent, repeat(memory_field), _dedent,
    )
}

rule rdwr {
    seq(
        mdir, "mport", identifier,
        "=",
        identifier, "[", expression, "]", ",", expression,
        optional(info),
    )
}

rule inst { seq("inst", identifier, "of", identifier, optional(info)) }

rule node { seq("node", identifier, "=", expression, optional(info)) }

rule connection { seq(expression, "<=", expression, optional(info)) }

rule partial_connection { seq(expression, "<-", expression, optional(info)) }

rule is_invalid { seq(expression, "is", "invalid", optional(info)) }

rule memory_field {
    seq(
        choice(
            seq("data-type", "=>", type),
            seq(
                choice("depth", "read-latency", "write-latency"),
                "=>", number,
            ),
            seq("read-under-write", "=>", ruw),
            seq(choice("reader", "writer", "readwriter"), "=>", sep1(",", identifier)),
        ),
        _newline,
    )
}

rule suite {
    choice(
        statement,
        seq(_indent, repeat1(statement), _dedent),
    )
}

rule when {
    prec_right(0, seq(
        "when",
        expression,
        ":",
        optional(info),
        optional(suite),
        optional(else),
    ))
}

rule else {
    seq("else", choice(when, seq(":", optional(info), suite)))
}

rule stop {
    seq("stop", "(", expression, ",", expression, ",", number, ")", optional(info))
}

rule printf {
    seq(
        "printf",
        "(",
        expression, ",",
        expression, ",",
        string,
        repeat(seq(",", expression)),
        ")",
        optional(info),
    )
}

rule verif {
    seq(
        choice("assert", "assume", "cover"),
        "(",
        expression, ",",
        expression, ",",
        expression, ",",
        string,
        ")",
    )
}

rule skip { seq("skip", optional(info)) }

rule attach {
    seq("attach", "(", sep1(",", expression), ")", optional(info))
}

rule info { regexp(r"@\[.*\]") }

rule mdir { choice("infer", "read", "write", "rdwr") }

rule ruw { choice("old", "new", "undefined") }

rule litType {
    seq(choice("UInt", "SInt"), optional(seq("<", number, ">")))
}

rule expression {
    choice(
        literal, identifier, keyword_identifier,
        sub_field, sub_index, sub_access,
        mux, conditionally_valid, primitive_operation,
    )
}

rule literal {
    seq(litType, "(", choice(number, number_str), ")")
}

rule sub_field { seq(expression, ".", field_id) }

rule sub_index { seq(expression, "[", number, "]") }

rule sub_access { seq(expression, "[", expression, "]") }

rule mux {
    seq("mux", "(", expression, ",", expression, ",", expression, ")")
}

rule conditionally_valid {
    seq("validif", "(", expression, ",", expression, ")")
}

rule primitive_operation {
    seq(primop, "(", sep1(",", choice(expression, number)), ")")
}

rule field_id { choice(identifier, relaxed_identifier, uint) }

rule primop {
    choice(
        "add", "sub", "mul", "div", "rem", "lt", "leq", "gt", "geq", "eq", "neq",
        "pad", "asUInt", "asAsyncReset", "asSInt", "asClock",
        "shl", "shr", "dshl", "dshlw", "dshr", "dshrw",
        "cvt", "neg", "not", "and", "or", "xor", "andr", "orr", "xorr",
        "cat", "bits", "head", "tail",
        "asFixedPoint", "bpshl", "bpshr", "bpset",
    )
}

rule uint { choice("0", regexp(r"[1-9][0-9]*")) }

rule sint { seq(choice("+", "-"), regexp(r"[1-9][0-9]*")) }

rule number { alias(choice(uint, sint), number) }

rule number_str {
    token(choice(
        regexp(r#""h[+-]?[a-fA-F0-9]+""#),
        regexp(r#""o[+-]?[0-7]+""#),
        regexp(r#""b[+-]?[01]+""#),
    ))
}

rule double { regexp(r"[+-]*[0-9]+\.[0-9]+(E[+-]?[0-9]+)?") }

rule string {
    seq(
        "\"",
        repeat(choice(string_content, _escape_sequence)),
        "\"",
    )
}

rule raw_string {
    seq(
        "'",
        repeat(choice(alias(raw_string_content, string_content), _escape_sequence)),
        "'",
    )
}

rule string_content { token(prec(-1, regexp(r#"[^"\\]+"#))) }

rule raw_string_content { token(prec(-1, regexp(r"[^'\\]+"))) }

rule _escape_sequence {
    choice(
        prec(2, token_immediate(seq("\\", regexp(r#"[^abfnrtvxu'"\\?]"#)))),
        prec(1, escape_sequence),
    )
}

rule escape_sequence {
    token_immediate(seq("\\", choice(
        regexp(r"[^xu0-7]"),
        regexp(r"[0-7]{1,3}"),
        regexp(r"x[0-9a-fA-F]{2}"),
        regexp(r"u[0-9a-fA-F]{4}"),
        regexp(r"u\{[0-9a-fA-F]+\}"),
    )))
}

rule identifier { regexp(r"[a-zA-Z_][a-zA-Z0-9_$]*") }

rule relaxed_identifier { regexp(r"[a-zA-Z0-9_$]+") }

rule keyword_identifier {
    prec(-3, alias(choice(primop, "mux"), identifier))
}

rule comment { token(seq(";", regexp(r".*"))) }
